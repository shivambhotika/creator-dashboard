# Local development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
SKIP_AUTH_IN_DEV=true

# Dashboard login
DASHBOARD_EMAIL=shivam@wispr.ai
DASHBOARD_PASSWORD=<local-dashboard-password>

# Google OAuth
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
ALLOWED_EMAIL_DOMAIN=wispr.ai

# Data providers
YOUTUBE_API_KEY=<youtube-data-api-key>
DUB_API_KEY=<dub-api-key>

# Scheduled sync and persistence
CRON_SECRET=<random-cron-secret>
DATABASE_URL=<postgres-url>
SNAPSHOT_STORAGE_FILE=.data/creator-dashboard-storage.json

# Daily social listening Slack digest
SLACK_SOCIAL_DIGEST_WEBHOOK_URL=<slack-incoming-webhook-url>
SOCIAL_LISTENING_KEYWORDS=WisprFlow,Wispr Flow,wisprflow.ai,ref.wisprflow.ai,Wispr AI
SOCIAL_LISTENING_INCLUDE_TERMS=
SOCIAL_LISTENING_EXCLUDE_TERMS=job opening,hiring
SOCIAL_LISTENING_REDDIT_SUBREDDITS=
SOCIAL_LISTENING_LOOKBACK_HOURS=24
SOCIAL_LISTENING_MAX_ITEMS=20
SOCIAL_LISTENING_DISABLE_REDDIT=false

# X/Twitter and LinkedIn social listening providers
X_BEARER_TOKEN=<x-api-bearer-token>
SOCIAL_MCP_SEARCH_URL=<twitter-like-mcp-http-bridge-url>
SOCIAL_MCP_API_KEY=<twitter-like-mcp-bridge-key>
LINKEDIN_SEARCH_API_URL=<linkedin-search-bridge-url>
LINKEDIN_SEARCH_API_KEY=<linkedin-search-bridge-key>
SERPAPI_KEY=<serpapi-key>

# Optional screenshots in Slack/dashboard result links
SOCIAL_SCREENSHOT_URL_TEMPLATE=<screenshot-url-template-with-{url}>
SCREENSHOTONE_ACCESS_KEY=<screenshotone-access-key>
